#!/usr/bin/env python3
"""Parses the built GTK stylesheets with GTK itself and reports every error.

A broken selector list does not fail loudly: GTK drops the rule and the app
just looks wrong. build.sh runs this after compiling, when PyGObject is
installed.

  tools/check-css 3 FILE...   check with GTK 3
  tools/check-css 4 FILE...   check with GTK 4
"""
import sys

import gi

version, files = sys.argv[1], sys.argv[2:]
gi.require_version('Gtk', f'{version}.0')
from gi.repository import Gtk  # noqa: E402

failed = False
for path in files:
    errors = []
    provider = Gtk.CssProvider()
    provider.connect('parsing-error',
                     lambda _p, section, error: errors.append(f'{section.to_string()}: {error.message}'))
    try:
        provider.load_from_path(path)
    except Exception as e:  # GTK 3 also raises on the first error
        errors.append(str(e))
    for error in dict.fromkeys(errors):
        print(f'{path}: {error}', file=sys.stderr)
    failed |= bool(errors)

sys.exit(1 if failed else 0)
