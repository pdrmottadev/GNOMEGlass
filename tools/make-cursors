#!/usr/bin/env python3
"""Generates the GNOME Glass cursor theme (Xcursor files) from vector shapes.

  tools/make-cursors [OUTPUT_DIR]          (default: themes/GNOMEGlass-Cursors)
  tools/make-cursors --preview FILE.png    also writes a preview strip

Every shape is drawn on a 24x24 grid (the nominal cursor size) and rendered
with librsvg at each size in SIZES. The Xcursor files are written directly
(no xcursorgen needed): cairo's premultiplied ARGB32 is exactly the pixel
format Xcursor expects.
"""
import math
import os
import shutil
import struct
import sys

import cairo
import gi

gi.require_version('Rsvg', '2.0')
from gi.repository import Rsvg  # noqa: E402

SIZES = (24, 30, 36, 48, 72, 96)
FRAMES = 60          # animation frames per turn of the spinner
FRAME_DELAY = 16     # ms per frame (~1 turn per second)

OUTLINE = '#0f1828'

# Glass gradients: light on top, a "horizon" halfway down (the Aero gloss),
# deeper below
GRADIENTS = {
    'glass': ('#ffffff', '#f3f7fd', '#dce7f8', '#c8d8ef'),
    'blue':  ('#b4dbff', '#63aef8', '#2f80e0', '#1a5cb4'),
    'ember': ('#ffb6a6', '#ff7d68', '#e5483b', '#b3261b'),
    'green': ('#a6ecc2', '#47c682', '#26a269', '#1a7a4c'),
    'smoke': ('#7a8396', '#454e60', '#2a303d', '#1b2029'),
}

DEFS = ''.join(f'''
  <linearGradient id="{name}" x1="0" y1="0" x2="0.55" y2="1">
    <stop offset="0" stop-color="{a}"/><stop offset="0.48" stop-color="{b}"/>
    <stop offset="0.5" stop-color="{c}"/><stop offset="1" stop-color="{d}"/>
  </linearGradient>''' for name, (a, b, c, d) in GRADIENTS.items()) + '''
  <filter id="drop" x="-30%" y="-30%" width="160%" height="160%">
    <feGaussianBlur in="SourceAlpha" stdDeviation="0.7"/>
    <feOffset dx="0.35" dy="0.9" result="blur"/>
    <feComponentTransfer><feFuncA type="linear" slope="0.45"/></feComponentTransfer>
    <feMerge><feMergeNode/><feMergeNode in="SourceGraphic"/></feMerge>
  </filter>'''

_ids = iter(range(1, 1 << 30))


def svg(*parts):
    return ('<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">'
            f'<defs>{DEFS}</defs><g filter="url(#drop)">{"".join(parts)}</g></svg>')


def glass(d, fill='glass', transform=''):
    """A glass shape: dark outline outside, gradient fill, bright rim inside."""
    clip = f'c{next(_ids)}'
    t = f' transform="{transform}"' if transform else ''
    return (f'<g{t}>'
            f'<clipPath id="{clip}"><path d="{d}"/></clipPath>'
            f'<path d="{d}" fill="{OUTLINE}" stroke="{OUTLINE}" stroke-width="2.2" stroke-linejoin="round"/>'
            f'<path d="{d}" fill="url(#{fill})"/>'
            f'<path d="{d}" fill="none" stroke="#ffffff" stroke-opacity="0.75" stroke-width="1.1" '
            f'clip-path="url(#{clip})"/>'
            '</g>')


def circle_path(cx, cy, r):
    return f'M {cx - r} {cy} a {r} {r} 0 1 0 {2 * r} 0 a {r} {r} 0 1 0 {-2 * r} 0 Z'


