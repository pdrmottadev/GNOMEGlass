def render(svg_text, size):
    handle = Rsvg.Handle.new_from_data(svg_text.encode())
    surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, size, size)
    ctx = cairo.Context(surface)
    viewport = Rsvg.Rectangle()
    viewport.x, viewport.y, viewport.width, viewport.height = 0, 0, size, size
    handle.render_document(ctx, viewport)
    surface.flush()
    return surface


def xcursor(images):
    """images: list of (nominal size, surface, xhot, yhot, delay)."""
    header = struct.pack('<4sIII', b'Xcur', 16, 0x10000, len(images))
    toc, chunks = b'', b''
    pos = 16 + 12 * len(images)
    for size, surface, xhot, yhot, delay in images:
        w, h = surface.get_width(), surface.get_height()
        chunk = struct.pack('<9I', 36, 0xfffd0002, size, 1, w, h, xhot, yhot, delay)
        chunk += bytes(surface.get_data())  # premultiplied ARGB, native endian
        toc += struct.pack('<III', 0xfffd0002, size, pos)
        chunks += chunk
        pos += len(chunk)
    return header + toc + chunks


def build(out):
    if os.path.isdir(out):
        shutil.rmtree(out)
    cursors = os.path.join(out, 'cursors')
    os.makedirs(cursors)
    with open(os.path.join(out, 'index.theme'), 'w') as f:
        f.write('[Icon Theme]\nName=GNOME Glass Cursors\n'
                'Comment=Glass cursors from GNOME Glass\nInherits=Adwaita\n')
    for name, (hx, hy, frames, draw) in CURSORS.items():
        images = []
        for size in SIZES:
            scale = size / 24
            xhot = min(size - 1, round(hx * scale))
            yhot = min(size - 1, round(hy * scale))
            for frame in range(frames):
                images.append((size, render(draw(frame), size), xhot, yhot,
                               FRAME_DELAY if frames > 1 else 50))
        with open(os.path.join(cursors, name), 'wb') as f:
            f.write(xcursor(images))
        for alias in ALIASES.get(name, []):
            os.symlink(name, os.path.join(cursors, alias))


PREVIEW = ['default', 'pointer', 'text', 'grab', 'grabbing', 'help', 'progress', 'wait',
           'copy', 'alias', 'context-menu', 'not-allowed', 'crosshair', 'all-scroll',
           'nwse-resize', 'col-resize', 'zoom-in']


def preview(path, size=48, pad=16):
    """A strip of cursors over a light and a dark band."""
    w = len(PREVIEW) * (size + pad) + pad
    h = 2 * (size + pad) + pad
    surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, w, h)
    ctx = cairo.Context(surface)
    for i, (top, bottom) in enumerate((('#e9f1fb', '#cfe0f5'), ('#1d2433', '#0e1320'))):
        y0 = i * h / 2
        grad = cairo.LinearGradient(0, y0, 0, y0 + h / 2)
        for stop, color in ((0, top), (1, bottom)):
            grad.add_color_stop_rgb(stop, *(int(color[j:j + 2], 16) / 255 for j in (1, 3, 5)))
        ctx.set_source(grad)
        ctx.rectangle(0, y0, w, h / 2)
        ctx.fill()
        for j, name in enumerate(PREVIEW):
            hx, hy, frames, draw = CURSORS[name]
            ctx.set_source_surface(render(draw(frames // 8), size), pad + j * (size + pad), y0 + pad / 2)
            ctx.paint()
    surface.write_to_png(path)


if __name__ == '__main__':
    args = sys.argv[1:]
    preview_path = None
    if '--preview' in args:
        i = args.index('--preview')
        preview_path = args[i + 1]
        del args[i:i + 2]
    build(args[0] if args else 'themes/GNOMEGlass-Cursors')
    if preview_path:
        preview(preview_path)
