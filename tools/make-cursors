def forbidden(cx, cy, r, width):
    """Ember ring with a slash: outlines first, so they merge into one shape."""
    k = r / math.sqrt(2)
    slash = f'M {cx - k} {cy - k} L {cx + k} {cy + k}'
    return (f'<circle cx="{cx}" cy="{cy}" r="{r}" fill="none" stroke="{OUTLINE}" stroke-width="{width + 2.2}"/>'
            f'<path d="{slash}" stroke="{OUTLINE}" stroke-width="{width + 2.2}"/>'
            f'<circle cx="{cx}" cy="{cy}" r="{r}" fill="none" stroke="url(#ember)" stroke-width="{width}"/>'
            f'<path d="{slash}" stroke="url(#ember)" stroke-width="{width}"/>'
            f'<circle cx="{cx}" cy="{cy}" r="{r + width * 0.2}" fill="none" stroke="#ffffff" '
            f'stroke-opacity="0.7" stroke-width="{width * 0.28}" stroke-linecap="round" '
            f'stroke-dasharray="{r * 0.9:.2f} {r * 20:.2f}" transform="rotate(195 {cx} {cy})"/>')


