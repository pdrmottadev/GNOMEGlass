def creases(lines):
    return ''.join(f'<path d="M {x} {y0 + 0.6} L {x} {y1}" stroke="{OUTLINE}" stroke-opacity="0.55" '
                   f'stroke-width="0.8" stroke-linecap="round"/>' for x, y0, y1 in lines)


def ring(cx, cy, r, width, angle, fill='blue'):
    """A glass ring with a colored arc (a quarter and a bit) at `angle`."""
    circ = 2 * math.pi * r
    return (f'<circle cx="{cx}" cy="{cy}" r="{r}" fill="none" stroke="{OUTLINE}" stroke-width="{width + 2.2}"/>'
            f'<circle cx="{cx}" cy="{cy}" r="{r}" fill="none" stroke="url(#glass)" stroke-width="{width}"/>'
            f'<circle cx="{cx}" cy="{cy}" r="{r}" fill="none" stroke="url(#{fill})" stroke-width="{width}" '
            f'stroke-linecap="round" stroke-dasharray="{circ * 0.3:.3f} {circ:.3f}" '
            f'transform="rotate({angle} {cx} {cy})"/>'
            # a fixed specular glint on the upper left of the ring
            f'<circle cx="{cx}" cy="{cy}" r="{r + width * 0.18}" fill="none" stroke="#ffffff" '
            f'stroke-opacity="0.8" stroke-width="{width * 0.3}" stroke-linecap="round" '
            f'stroke-dasharray="{circ * 0.1:.3f} {circ * 2:.3f}" transform="rotate(200 {cx} {cy})"/>')


def badge(fill, glyph):
    """A small glass orb at the lower right of the arrow, with a white glyph."""
    return glass(circle_path(17.6, 17.6, 4.5), fill) + glyph


def white(d, width=1.4):
    return (f'<path d="{d}" fill="none" stroke="#ffffff" stroke-width="{width}" '
            'stroke-linecap="round" stroke-linejoin="round"/>')


