            '<circle cx="10" cy="10" r="5.1" fill="#a9d1ff" fill-opacity="0.45"/>'
            '<ellipse cx="8.4" cy="7.6" rx="3" ry="1.8" fill="#ffffff" fill-opacity="0.55" '
            'transform="rotate(-35 8.4 7.6)"/>'
            '<circle cx="10" cy="10" r="6.2" fill="none" stroke="url(#glass)" stroke-width="2.2"/>'
            + glyph)


